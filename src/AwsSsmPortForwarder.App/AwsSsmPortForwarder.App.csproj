<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AwsSsmPortForwarder</RootNamespace>
    <AssemblyName>AwsSsmPortForwarder</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AwsSsmPortForwarder.Core\AwsSsmPortForwarder.Core.csproj" />
    <ProjectReference Include="..\AwsSsmPortForwarder.Infrastructure\AwsSsmPortForwarder.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
